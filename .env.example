# Copy to .env and fill in as needed. Never commit .env (it is git-ignored).
# Load it with:  uvicorn app.main:app --reload --env-file .env
# Every setting is optional; the defaults below are what the app uses when unset.
# An invalid or out-of-range value is not fatal: the app uses the default (or the
# nearest allowed value) and logs one warning naming the setting.

# --- GitHub -------------------------------------------------------------------
# Raises GitHub's API limit from 60 to 5,000 requests/hour. A fine-grained token
# with NO permissions is enough for public repositories (TriageBot only reads).
GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com
# GITHUB_TIMEOUT=10

# --- Storage --------------------------------------------------------------------
# SQLite in WAL mode: <db>-wal and <db>-shm files appear next to it. Keep the
# database on a local disk (not a network share).
# TRIAGEBOT_DB=./triagebot.db

# --- ML category classifier ------------------------------------------------------
# TRIAGEBOT_ML_ENABLED=1                      # 0 = keyword rules only
# TRIAGEBOT_MODEL_PATH=./models/issue_classifier
# TRIAGEBOT_ML_THRESHOLD=0.5                  # below this probability the rules decide

# --- Duplicate detection ---------------------------------------------------------
# TRIAGEBOT_DUP_THRESHOLD=0.2                 # minimum similarity for a suggestion

# --- PR insights -----------------------------------------------------------------
# TRIAGEBOT_PR_STALE_DAYS=30
# TRIAGEBOT_PR_LARGE_LINES=500
# TRIAGEBOT_PR_LARGE_FILES=20
