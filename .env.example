# Copy to .env and fill in as needed. Never commit .env (it is git-ignored).
# Load it with:  uvicorn app.main:app --reload --env-file .env

# Optional. Raises GitHub's API limit from 60 to 5,000 requests/hour.
# A fine-grained token with NO permissions is enough for public repositories.
GITHUB_TOKEN=

# Optional. Where the SQLite database lives (default: ./triagebot.db).
# TRIAGEBOT_DB=./triagebot.db

# Optional. GitHub request timeout in seconds (default: 10).
# GITHUB_TIMEOUT=10
